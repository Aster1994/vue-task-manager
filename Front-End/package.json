{
  "name": "todo",
  "version": "1.0.0",
  "description": "Todo Manager front-end: Vue 3 + Vite + TypeScript + Tailwind v4 + Pinia + Axios, installable PWA",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "twa:init": "bubblewrap init --manifest https://app.etfbaz.com/manifest.json",
    "twa:build": "cd twa && bubblewrap build",
    "twa:build:release": "cd twa && bubblewrap build --release",
    "twa:update": "cd twa && bubblewrap update",
    "pwa:test": "npm run build && npm run preview"
  },
  "dependencies": {
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "npm-run-all2": "^9.0.3",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.11",
    "workbox-window": "^7.4.1"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0",
    "npm": ">=11"
  }
}
